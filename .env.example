# GitHub Merge Guardian: environment variable template.
# Names and placeholders ONLY. Never commit real values. See docs/vercel-deployment.md for per-environment setup.
# "server" variables must never be exposed to browser code (no NEXT_PUBLIC_ prefix).

# --- Public (browser-safe) -------------------------------------------------------------
# Slug of your GitHub App (https://github.com/apps/<slug>). Used only to render the install link.
NEXT_PUBLIC_GITHUB_APP_SLUG=your-guardian-app-slug

# --- App ---------------------------------------------------------------------------------
# Canonical public URL, no trailing slash. Used for OAuth redirects and dashboard links.
APP_URL=https://guardian.example.com
# >= 32 random characters. Signs dashboard session cookies.  (openssl rand -base64 48)
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated GitHub logins allowed to see every installation and the config-health detail.
GUARDIAN_ADMIN_LOGINS=

# --- GitHub App (server) -----------------------------------------------------------------
GITHUB_APP_ID=123456
# PEM private key. In Vercel paste the full multi-line key, or a single line with literal \n sequences.
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nREPLACE\n-----END RSA PRIVATE KEY-----
# >= 16 random characters; must equal the webhook secret configured on the GitHub App.
GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret
# OAuth credentials of the same GitHub App ("Client ID" / generated client secret). Used for dashboard sign-in.
GITHUB_APP_CLIENT_ID=Iv1.replace
GITHUB_APP_CLIENT_SECRET=replace-with-client-secret

# --- Database (server) -------------------------------------------------------------------
# Hosted PostgreSQL (Supabase: Project Settings -> Database -> "Transaction pooler" connection string, port 6543).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Durable jobs: Inngest (server) ------------------------------------------------------
INNGEST_EVENT_KEY=replace-with-inngest-event-key
INNGEST_SIGNING_KEY=signkey-prod-replace

# --- AI provider (server, optional) -------------------------------------------------------
# Without a key Guardian still runs every deterministic analyzer; the AI step reports "skipped".
ANTHROPIC_API_KEY=
GUARDIAN_MODEL=claude-sonnet-5-5
# "true" makes an unavailable AI provider an ERROR instead of a degraded run (also settable in risk-policy.yaml).
GUARDIAN_AI_REQUIRED=false

# --- Repair engine (server, optional; OFF by default) --------------------------------------
# When true the App may create guardian/fix-PR-<n> branches and DRAFT PRs. Requires contents:write on the App.
GUARDIAN_REPAIR_ENABLED=false

# --- Limits --------------------------------------------------------------------------------
GUARDIAN_MAX_SNAPSHOT_MB=60

# --- Not read by the app: used only by GitHub Actions secrets in the TARGET repository ------
# GUARDIAN_PREVIEW_BYPASS_TOKEN   Vercel "Protection Bypass for Automation" secret (preview-e2e.yml)
# VERCEL_TOKEN / VERCEL_ORG_ID    only if you choose the Vercel API path for deployment lookup
